# Production Firebase web config for beergame-mygames-live.
# These VITE_* values are public (they ship in the browser bundle) — safe to keep here.
# Used by `npm run build` (vite production mode). Emulators + App Check stay OFF.
VITE_FIREBASE_API_KEY=AIzaSyBjZBWU78dlscQ9cSnr46OM788SgHhfPaM
VITE_FIREBASE_AUTH_DOMAIN=beergame-mygames-live.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=beergame-mygames-live
VITE_FIREBASE_STORAGE_BUCKET=beergame-mygames-live.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=512620184151
VITE_FIREBASE_APP_ID=1:512620184151:web:b9cb1c4e97b534375e1912
VITE_FIREBASE_MEASUREMENT_ID=
# CRITICAL: explicitly OFF for production. The local-dev root .env sets
# VITE_USE_EMULATORS=true, and Vite still loads .env during `vite build`, so this
# override is what keeps the deployed bundle pointed at real Firebase (not localhost).
VITE_USE_EMULATORS=false
# App Check off for the first deploy (opt-in). To enable later:
#   VITE_USE_APPCHECK=true  +  VITE_RECAPTCHA_SITE_KEY=<key>
